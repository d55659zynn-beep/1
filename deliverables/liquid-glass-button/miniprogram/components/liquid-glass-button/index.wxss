.lgb {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
  transition: transform 0.16s cubic-bezier(0.22, 0.61, 0.36, 1);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.lgb--disabled {
  opacity: 0.5;
}

/* 1. 假毛玻璃：放大 2 倍并偏移，保证模糊边缘不露白 */
.lgb__blur {
  position: absolute;
  left: -50%;
  top: -50%;
  width: 200%;
  height: 200%;
  opacity: 0.75;
  pointer-events: none;
}

.lgb__blur--color {
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.45),
    rgba(255, 255, 255, 0.08)
  );
}

/* 2. 玻璃底色：白色径向渐变 30% → 10% */
.lgb__frost {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(
    circle at 30% 24%,
    rgba(255, 255, 255, 0.3),
    rgba(255, 255, 255, 0.1)
  );
  pointer-events: none;
}

/* 3. 液态高光扫过，时长由 animation-duration 内联控制 */
.lgb__sheen {
  position: absolute;
  left: -50%;
  top: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0) 38%,
    rgba(255, 255, 255, 0.42) 50%,
    rgba(255, 255, 255, 0) 62%
  );
  animation-name: lgb-sheen;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  pointer-events: none;
}

@keyframes lgb-sheen {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 4. 描边 + 顶部镜面内高光 */
.lgb__rim {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: inherit;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.45),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.lgb__content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.86);
}
