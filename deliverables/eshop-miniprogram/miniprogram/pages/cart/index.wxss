.page {
  padding: 20rpx 24rpx 160rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.item__check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #d8dbdf;
  margin-right: 16rpx;
}

.item__check--on {
  background: #e0533d;
  border-color: #e0533d;
}

.item__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #eceef0;
  margin-right: 16rpx;
}

.item__info {
  flex: 1;
  min-width: 0;
}

.item__title {
  font-size: 28rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.item__del {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  color: #8a8f98;
  font-size: 22rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper__btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border: 2rpx solid #d8dbdf;
  border-radius: 8rpx;
  color: #5f646b;
}

.stepper__num {
  width: 64rpx;
  text-align: center;
  font-size: 28rpx;
}

.empty__btn {
  width: 240rpx;
  margin: 32rpx auto 0;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #eceef0;
}

.bar__btn {
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #e0533d;
  color: #fff;
  font-size: 30rpx;
}
