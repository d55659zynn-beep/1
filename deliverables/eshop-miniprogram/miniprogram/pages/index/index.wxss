.page {
  padding: 20rpx 24rpx 40rpx;
}

.search {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search__input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.search__btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #e0533d;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.cats {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cats__item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 30rpx;
  color: #5f646b;
  font-size: 26rpx;
}

.cats__item--on {
  background: #e0533d;
  color: #fff;
}

.banner {
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(120deg, #ff8a5c, #e0533d);
  color: #fff;
}

.banner__title {
  font-size: 36rpx;
  font-weight: 600;
}

.banner__desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.goods {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.goods__item {
  width: calc(50% - 10rpx);
}

.loading {
  padding: 24rpx;
  text-align: center;
  color: #8a8f98;
  font-size: 24rpx;
}
