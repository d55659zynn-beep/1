<view class="page">
  <view class="search">
    <input
      class="search__input"
      placeholder="搜索商品"
      value="{{keyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
      confirm-type="search"
    />
    <view class="search__btn" bindtap="onSearch">搜索</view>
  </view>

  <scroll-view class="cats" scroll-x>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cats__item {{categoryId === item.id ? 'cats__item--on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategory"
    >{{item.name}}</view>
  </scroll-view>

  <view class="banner">
    <view class="banner__title">新人首单立减</view>
    <view class="banner__desc">下单即享优惠，先到先得</view>
  </view>

  <view class="goods" wx:if="{{list.length}}">
    <view class="goods__item" wx:for="{{list}}" wx:key="_id">
      <goods-card item="{{item}}" show-add bind:tap="onCardTap" bind:add="onAdd" />
    </view>
  </view>

  <view class="empty" wx:else>还没有在售商品，去「我的 - 商品管理」上架吧</view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="loading" wx:if="{{noMore && list.length}}">没有更多了</view>
</view>
