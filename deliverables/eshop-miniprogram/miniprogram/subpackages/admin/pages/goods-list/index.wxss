.page {
  padding: 20rpx 24rpx 60rpx;
}

.topbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.topbar__search {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.topbar__add {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #e0533d;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.tabs {
  display: flex;
  margin-bottom: 20rpx;
}

.tabs__item {
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 30rpx;
  color: #5f646b;
  font-size: 26rpx;
}

.tabs__item.on {
  background: #e0533d;
  color: #fff;
}

.goods {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eceef0;
  margin-right: 20rpx;
}

.goods__body {
  flex: 1;
  min-width: 0;
}

.goods__title {
  font-size: 28rpx;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.goods__ops {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
}

.op {
  color: #5f646b;
}

.op--danger {
  color: #e0533d;
}
