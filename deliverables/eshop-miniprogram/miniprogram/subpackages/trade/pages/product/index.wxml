<view class="page" wx:if="{{detail}}">
  <swiper class="swiper" indicator-dots circular>
    <swiper-item wx:for="{{detail.images}}" wx:key="*this">
      <image class="swiper__img" src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="card info">
    <view class="info__price">
      <text class="price">{{detail.price / 100}}</text>
      <text class="info__origin" wx:if="{{detail.marketPrice}}">¥{{detail.marketPrice / 100}}</text>
    </view>
    <view class="info__title">{{detail.title}}</view>
    <view class="muted" wx:if="{{detail.subtitle}}">{{detail.subtitle}}</view>
    <view class="row between info__meta">
      <text class="muted">库存 {{detail.stock}}</text>
      <text class="muted">已售 {{detail.sales || 0}}</text>
    </view>
  </view>

  <view class="card desc" wx:if="{{detail.description}}">
    <view class="desc__title">商品详情</view>
    <view class="desc__body">{{detail.description}}</view>
  </view>

  <view class="bar">
    <view class="bar__cart" bindtap="onAddCart">加入购物车</view>
    <view class="bar__buy" bindtap="onBuy">立即购买</view>
  </view>
</view>

<view class="empty" wx:else>商品不存在或已下架</view>
