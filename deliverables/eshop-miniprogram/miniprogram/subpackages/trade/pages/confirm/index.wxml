<view class="page">
  <view class="card addr">
    <view class="addr__row">
      <text class="addr__label">收货人</text>
      <input class="addr__input" placeholder="姓名" value="{{address.name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="addr__row">
      <text class="addr__label">手机号</text>
      <input class="addr__input" type="number" maxlength="11" placeholder="11 位手机号" value="{{address.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="addr__row">
      <text class="addr__label">收货地址</text>
      <input class="addr__input" placeholder="省市区 / 街道 / 门牌号" value="{{address.detail}}" data-field="detail" bindinput="onInput" />
    </view>
  </view>

  <view class="card list">
    <view class="list__item" wx:for="{{items}}" wx:key="productId">
      <image class="list__img" src="{{item.cover}}" mode="aspectFill" />
      <view class="list__info">
        <view class="list__title">{{item.title}}</view>
        <view class="row between">
          <text class="price">{{item.price / 100}}</text>
          <text class="muted">× {{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card note">
    <input class="note__input" placeholder="订单备注（选填）" value="{{remark}}" bindinput="onRemark" />
  </view>

  <view class="bar">
    <view class="bar__total">合计 <text class="price">{{total / 100}}</text></view>
    <view class="bar__btn" bindtap="onSubmit">提交并支付</view>
  </view>
</view>
